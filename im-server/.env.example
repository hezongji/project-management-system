# im-server 环境变量（复制为 .env 使用；禁止硬编码进代码）
# 与主服务共享同一 JWT 密钥：二者必须一致，否则握手鉴权失败。

# ── 认证 ──────────────────────────────────────────────
# 优先 JWT_SECRET，其次 SECRET。若不设置，启动时会回退读取主服务 ../.env / ../.env.local。
# JWT_SECRET=<用 openssl rand -hex 32 生成，切勿使用示例或真实环境旧值>

# ── 服务 ──────────────────────────────────────────────
IM_PORT=3002

# ── 数据库（PG 模式使用；留空则走内存存储）────────────
# IM_DATABASE_URL=postgresql://postgres:PmLocal2026!@localhost:5432/pm_dev
IM_DATABASE_URL=

# ── 存储模式：auto | memory | prisma ──────────────────
# auto：有可用的 PG 表时用 prisma，否则回退 memory
IM_STORE=auto

# ── 心跳（毫秒）───────────────────────────────────────
# Socket.IO 引擎级 pingInterval/pingTimeout（30s/10s）
IM_HEARTBEAT_MS=30000
IM_HEARTBEAT_TIMEOUT_MS=10000

# ── PG LISTEN/NOTIFY 通道名（§9.4）────────────────────
IM_NOTIFY_CHANNEL=im_events

# ── 演示数据（memory 模式；联调脚本依赖）───────────────
# 为 false 时不注入 conv-demo 演示群
IM_SEED_DEMO=true
