# =========================================================================
# .env.example — 项目管理系统环境变量模板
#
# 用法：
#   Docker 部署：  ./deploy/install.sh 会自动基于本模板生成 .env 并注入强密码
#   （手动方式：   cp .env.example .env  然后填值）
#   裸机部署：     请同时参考 docs/deployment.md 的「环境变量表」
#
# 占位符约定（仅 install.sh 识别）：
#   __AUTO_GENERATE__  由 install.sh 用 `openssl rand -hex 32` 替换为强随机值
#   __ASK__            由 install.sh 交互询问（或通过 --domain / --non-interactive 覆盖）
#
# 安全提示：生产环境务必更换 DB_PASSWORD / JWT_SECRET，
#          生成方式：openssl rand -hex 32
# =========================================================================

# ---------- 数据库（必填） ----------
# Docker 部署：compose 内用下面三项拼接 DATABASE_URL 连接内置 postgres
# 裸机/外部数据库：直接设置 DATABASE_URL（完整连接串），可覆盖内置拼接
DB_USER=pm
DB_PASSWORD=__AUTO_GENERATE__
DB_NAME=pm
# 可选：对外暴露 5432 端口。留空=仅本机回环 127.0.0.1 可达（公网不可见）。
# 需内网/公网访问时设 5432；宿主机已装 postgres 冲突时改其他端口（如 5433）或注释 compose 的 ports 段。
PG_EXPOSE_PORT=
# 外部数据库时显式指定（Docker 内置 postgres 无需设置）：
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ---------- 应用入口与地址 ----------
# 站点对外地址（生产填 https://你的域名，末尾不带斜杠）
APP_URL=http://localhost
# 仅 --https 模式（Caddy 自动签发证书）需要：你的域名，如 pm.example.com
DOMAIN=__ASK__
# HTTP 入口端口（HTTP 模式 nginx 监听；HTTPS 模式 Caddy 固定 80/443）
HTTP_PORT=80

# ---------- 认证（必填） ----------
# 主服务与 IM 服务共用的 JWT 密钥（HS256，30 天过期）。
# 生产未配置时 src/lib/auth.ts 会直接抛错拒绝启动，务必设置。
JWT_SECRET=__AUTO_GENERATE__
# 以下三项为历史遗留/预留字段，当前业务代码未消费（见 docs/deployment.md）
JWT_REFRESH_SECRET=__AUTO_GENERATE__
NEXTAUTH_SECRET=__AUTO_GENERATE__
NEXTAUTH_URL=

# ---------- 前端地址（NEXT_PUBLIC_* 为构建期注入） ----------
# Docker 部署：这三项通常留空，由 compose 基于 APP_URL 自动推导。
# 裸机部署：需要显式设置，供前端发起 API / WebSocket 连接。
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
# IM WebSocket 地址：指向 IM 服务 origin 根（不要带 /socket.io 等路径）。
# 默认回退 http://localhost:3002；Docker 部署由 APP_URL 推导，经 nginx/caddy 反代。
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_APP_NAME=项目管理系统

# ---------- 文件 / 网盘 ----------
# 文件根目录（Docker 部署指向容器内卷 /data/pm-files，由 compose 注入）
FILE_ROOT=uploads
# 单文件大小上限（字节，默认 100MB）
FILE_MAX_SIZE=104857600
# 每项目配额（字节，默认 10GB）
FILE_QUOTA_PER_PROJECT=10737418240
# 允许的上传 MIME 类型（逗号分隔；留空=接受任意合法 MIME）
ALLOWED_FILE_TYPES=
# 回收站保留天数（默认 30 天，见 src/lib/drive.ts）
DRIVE_RECYCLE_RETAIN_DAYS=30

# ---------- AI 助手（可选） ----------
# 不配置则 AI 助手功能不可用。优先级：AI_* > 旧 MIMO_*（见 src/lib/ai/mimo.ts）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# 旧版 MiMo 兼容回退（优先级低于 AI_*）
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=

# ---------- IM 服务（可选，均有默认值） ----------
# 监听端口（容器内固定 3002，一般无需改）
IM_PORT=3002
# IM 独立数据库连接串（默认回退 DATABASE_URL）
IM_DATABASE_URL=
# 存储模式：auto | memory | prisma（auto 会按环境自动选择）
IM_STORE=auto
# Socket.IO 允许的来源（逗号分隔），留空=不限制
CORS_ORIGIN=
IM_HEARTBEAT_MS=30000
IM_HEARTBEAT_TIMEOUT_MS=10000
IM_NOTIFY_CHANNEL=im_events
# 是否注入联调演示会话（test-user-a/b/c，生产建议设 false）
IM_SEED_DEMO=true
