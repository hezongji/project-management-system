# =========================================================================
# .env.example — 项目管理系统部署环境变量
# 用法：cp deploy/.env.example .env  →  修改为实际值
# 安全提示：生产环境必须更换 DB_PASSWORD / JWT_SECRET / NEXTAUTH_SECRET，
#         生成方式：openssl rand -hex 32
# =========================================================================

# ---------- 数据库 ----------
DB_USER=pm
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=pm
# PG 对外端口（内网部署建议注释掉 compose 里 postgres 的 ports 段）
PG_EXPOSE_PORT=5432

# ---------- 应用 / 认证 ----------
# 正式环境用 https:// 域名，如 https://pm.example.com
APP_URL=http://localhost:80
APP_NAME=项目管理系统
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32_2
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_hex_32_3

# ---------- 说明：HTTPS 证书 ----------
# 若启用 HTTPS：
#   1. 把证书放到 deploy/certs/（fullchain.pem + privkey.pem）
#   2. 在 deploy/nginx.conf 里取消注释 80→443 重定向，并新增 443 server 块
# 未配置证书时，默认走 HTTP（80 端口，见 nginx.conf 默认配置）
